APP_NAME="Absensi Siswa"

# Untuk produksi: APP_ENV=production, APP_DEBUG=false.
# Gunakan APP_ENV=local & APP_DEBUG=true hanya di mesin pengembangan.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Buffer menit setelah jam pulang sebelum siswa dianggap Alpa.
ATTENDANCE_ALPA_BUFFER_MINUTES=5

# Scan yang tanggalnya berbeda dari tanggal diterima server tidak diproses
# otomatis dan harus disetujui admin.
ATTENDANCE_SCAN_TIME_REVIEW_ENABLED=true
ATTENDANCE_MAX_SCAN_DELAY_MINUTES=60
ATTENDANCE_FUTURE_SCAN_TOLERANCE_MINUTES=5

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Log: gunakan channel daily agar file log tidak membengkak tanpa batas.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_siswa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Produksi: aktifkan enkripsi sesi.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Harus lebih besar dari timeout job terpanjang (SendWhatsAppBroadcastJob = 1800 detik),
# jika tidak, job broadcast yang berjalan lama bisa dianggap macet dan diambil worker lain.
DB_QUEUE_RETRY_AFTER=1860

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# WhatsApp Gateway (PRD FR-11, FR-12)
# Provider: log | meta | fonnte | mock
# ---------------------------------------------------------------------------
WA_GATEWAY_PROVIDER=fonnte
SCHOOL_NAME="SMA Negeri 1"
WA_RETRY_LIMIT=3

# Meta WhatsApp Cloud API (Graph API)
WA_META_VERSION=v20.0
WA_META_PHONE_NUMBER_ID=
WA_META_ACCESS_TOKEN=
# Token verifikasi GET webhook. Kosong = verifikasi ditolak (fail-closed).
WA_WEBHOOK_VERIFY_TOKEN=
# App Secret Meta untuk memvalidasi tanda tangan X-Hub-Signature-256 pada POST webhook.
WA_META_APP_SECRET=
# Rahasia bersama untuk webhook Fonnte: header X-Webhook-Token / X-Webhook-Secret,
# query ?token=, atau field payload secret/secret_key/webhook_secret/token.
# Kosong = semua request webhook ditolak (fail-closed). Wajib diisi untuk Fonnte.
WA_WEBHOOK_SECRET=
# Base URL publik webhook tanpa trailing slash, mis. https://wa.domainsekolah.id.
# Kosong = halaman Pengaturan Gateway menampilkan URL lokal.
WA_WEBHOOK_BASE_URL=
# true = request yang masuk lewat Cloudflare hanya boleh ke webhook dan /up.
WA_WEBHOOK_PUBLIC_ONLY=false

# Fonnte WhatsApp Gateway
WA_FONNTE_TOKEN=
WA_FONNTE_URL=https://api.fonnte.com/send
WA_FONNTE_VALIDATE_URL=https://api.fonnte.com/validate

# Validasi nomor WhatsApp wali (penghematan kuota)
WA_AUTO_VALIDATE_ON_SAVE=true
WA_VALIDATE_BATCH_DELAY_MS=500
WA_VALIDATE_CHUNK_SIZE=50
WA_NOTIFICATION_EXPIRATION_HOURS=24

# Validasi ulang berkala (default nonaktif)
WA_REVALIDATION_ENABLED=false
WA_REVALIDATION_DAYS=30

# ---------------------------------------------------------------------------
# System Service Supervisor (Auto-start & Dashboard Control)
# WAJIB diganti dengan token unik saat instalasi. Jangan gunakan nilai contoh.
# ---------------------------------------------------------------------------
SERVICE_SUPERVISOR_URL=http://127.0.0.1:4372
SERVICE_SUPERVISOR_TOKEN=

# ---------------------------------------------------------------------------
# Fingerprint Connector
# CONNECTOR_PRIMARY_DRIVER: auto | csharp | python  (auto = C# di Windows, Python di Linux)
# ---------------------------------------------------------------------------
CONNECTOR_PRIMARY_DRIVER=auto
CONNECTOR_ENTRYPOINT=connector/zkconnector.py
CONNECTOR_PYTHON_BIN=
CONNECTOR_LOCAL_API_URL=http://127.0.0.1:4371
# Token bersama untuk Local HTTP API connector; kosongkan hanya untuk instalasi lama.
CONNECTOR_LOCAL_API_TOKEN=

VITE_APP_NAME="${APP_NAME}"
