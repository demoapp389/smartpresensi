[Unit]
Description=SmartPresensi Solution X601 Fingerprint Connector
Documentation=file:///var/www/smartpresensi/docs/PANDUAN_DEPLOYMENT_LINUX.md
After=network-online.target
Wants=network-online.target
# Hentikan loop restart saat connector terus gagal/OOM.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/smartpresensi/connector
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /var/www/smartpresensi/connector/zkconnector.py
# on-failure: stop manual tidak memicu restart.
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
StandardOutput=append:/var/www/smartpresensi/storage/logs/connector_service.log
StandardError=append:/var/www/smartpresensi/storage/logs/connector_service.log
# Pengaman agar OOM hanya membunuh connector, bukan seluruh server.
MemoryHigh=768M
MemoryMax=1G
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
