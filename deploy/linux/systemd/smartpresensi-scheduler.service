[Unit]
Description=SmartPresensi Laravel Scheduler
Documentation=file:///var/www/smartpresensi/docs/PANDUAN_DEPLOYMENT_LINUX.md
After=network-online.target mysql.service
Wants=network-online.target
# Hentikan loop restart saat scheduler terus gagal/OOM.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/smartpresensi
ExecStart=/usr/bin/php8.3 artisan schedule:work
Restart=always
RestartSec=5
# Hardening systemd: batasi dampak bila proses scheduler dikompromikan.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
# Batas memori agar scheduler tidak menghabiskan RAM server.
MemoryMax=1G
StandardOutput=append:/var/www/smartpresensi/storage/logs/scheduler.log
StandardError=append:/var/www/smartpresensi/storage/logs/scheduler.log

[Install]
WantedBy=multi-user.target
