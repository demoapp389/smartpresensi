[Unit]
Description=SmartPresensi Laravel Scheduler
Documentation=file:///var/www/smartpresensi/docs/PANDUAN_DEPLOYMENT_LINUX.md
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/smartpresensi
ExecStart=/usr/bin/php8.3 artisan schedule:work
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
