[Unit]
Description=SmartPresensi Laravel Long-Running Queue Worker
Documentation=file:///var/www/smartpresensi/docs/PANDUAN_DEPLOYMENT_LINUX.md
After=network-online.target mysql.service
Wants=network-online.target
# Hentikan loop restart saat worker long-running terus gagal/OOM.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/smartpresensi
ExecStart=/usr/bin/php8.3 artisan queue:work --queue=long-running --tries=3 --timeout=3660 --sleep=3
Restart=always
RestartSec=5
TimeoutStopSec=90
# Hardening systemd: batasi dampak bila proses worker dikompromikan.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
# Job impor/ekspor besar butuh ruang lebih; tetap dibatasi agar tidak OOM total.
MemoryMax=2G
StandardOutput=append:/var/www/smartpresensi/storage/logs/queue_worker_long_service.log
StandardError=append:/var/www/smartpresensi/storage/logs/queue_worker_long_service.log

[Install]
WantedBy=multi-user.target
